#!/bin/sh
# Reject commits whose staged text files violate the encoding policy (docs/PLAN.md section 7.4).
# Enabled per clone with: git config core.hooksPath .githooks
python -X utf8 "$(git rev-parse --show-toplevel)/tools/check_text.py" --staged || {
  echo "pre-commit: encoding check failed; fix the files listed above (docs/PLAN.md 7.4)" >&2
  exit 1
}
