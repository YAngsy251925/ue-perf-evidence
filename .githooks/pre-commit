#!/bin/sh
# Reject commits whose staged text files violate the encoding policy (policy E1–E8).
# Enabled per clone with: git config core.hooksPath .githooks
python -X utf8 "$(git rev-parse --show-toplevel)/tools/check_text.py" --staged || {
  echo "pre-commit: encoding check failed; fix the files listed above (policy E1–E8)" >&2
  exit 1
}
