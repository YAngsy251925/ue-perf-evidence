{
  "schema": "perf-profile/0",
  "name": "lyra_measure",
  "class": "measure",
  "description": "M3.4 的 Lyra 组：与 measure 同一套 §7.2 固定条件，地图换成 Lyra 前端（真实游戏内容，帧时间 ~10-20ms，噪声基线才有意义）",
  "map": "/Game/System/FrontEnd/Maps/L_LyraFrontEnd",
  "rhi": "default",
  "window": {"windowed": true, "resx": 960, "resy": 540},
  "flags": ["-unattended", "-nosplash", "-nosound"],
  "statnamedevents": true,
  "trace": {"channels": ["cpu", "frame", "gpu", "bookmark"], "tail_mb": 64, "tail_mb_provisional": true},
  "cvars": {"t.MaxFPS": "0", "r.VSync": "0", "r.GTSyncType": "0", "t.IdleWhenNotForeground": "0"},
  "set_res_cvar": true,
  "exec_cmds": [],
  "csv": {
    "coverage_start_s": 35,
    "stop_at_s": 45,
    "exit": "exit_after_csv"
  },
  "conditions": {"warmup_frames": 60, "duration_s": 30, "camera": "static", "frame_generation": "off"},
  "stop": {"mode": "clean_exit", "startup_budget_s": 300, "exit_budget_s": 30}
}
