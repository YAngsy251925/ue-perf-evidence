{
  "schema": "perf-profile/0",
  "name": "memory",
  "class": "measure",
  "description": "M6.1 内存通道：measure 的全部固定条件 + 在 coverage_probe 段（stats 窗口之后，35–45s 之间）执行 memreport——重操作落在探针段，统计窗口的 p99 不受影响（R7 / P15）",
  "map": "/Engine/Maps/Entry",
  "rhi": "default",
  "window": {
    "windowed": true,
    "resx": 960,
    "resy": 540
  },
  "flags": [
    "-unattended",
    "-nosplash",
    "-nosound"
  ],
  "statnamedevents": true,
  "trace": {
    "channels": [
      "cpu",
      "frame",
      "gpu",
      "bookmark"
    ],
    "tail_mb": 64,
    "tail_mb_provisional": true
  },
  "cvars": {
    "t.MaxFPS": "0",
    "r.VSync": "0",
    "r.GTSyncType": "0",
    "t.IdleWhenNotForeground": "0"
  },
  "set_res_cvar": true,
  "exec_cmds": [],
  "csv": {
    "coverage_start_s": 35,
    "stop_at_s": 45,
    "exit": "exit_after_csv"
  },
  "conditions": {
    "warmup_frames": 60,
    "duration_s": 30,
    "camera": "static",
    "frame_generation": "off"
  },
  "stop": {
    "mode": "clean_exit",
    "startup_budget_s": 300,
    "exit_budget_s": 30
  },
  "exec_at": {
    "at_s": 40,
    "command": "memreport",
    "in_probe": true
  }
}
