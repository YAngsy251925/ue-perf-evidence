{
  "schema": "perf-profile/0",
  "name": "slate_probe",
  "class": "measure",
  "description": "逐控件 UI 成本采集：在 measure 基础上打开引擎的 SlateTrace 通道（Slate widget lifecycle + per-frame counts），配合 Slate Insights 插件可得到 WidgetId / WidgetPath / 每次更新耗时 /失效原因（WidgetInvalidated 还带 ScriptTrace 与调用栈）",
  "map": "/Engine/Maps/Entry",
  "rhi": "default",
  "window": {
    "windowed": true,
    "resx": 960,
    "resy": 540
  },
  "flags": [
    "-unattended",
    "-nosplash",
    "-nosound"
  ],
  "statnamedevents": true,
  "trace": {
    "channels": [
      "cpu",
      "frame",
      "gpu",
      "bookmark",
      "slate"
    ],
    "tail_mb": 64,
    "tail_mb_provisional": true
  },
  "cvars": {
    "t.MaxFPS": "0",
    "r.VSync": "0",
    "r.GTSyncType": "0",
    "t.IdleWhenNotForeground": "0"
  },
  "set_res_cvar": true,
  "exec_cmds": [],
  "csv": {
    "coverage_start_s": 35,
    "stop_at_s": 45,
    "exit": "exit_after_csv"
  },
  "conditions": {
    "warmup_frames": 60,
    "duration_s": 30,
    "camera": "static",
    "frame_generation": "off"
  },
  "stop": {
    "mode": "clean_exit",
    "startup_budget_s": 300,
    "exit_budget_s": 30
  }
}
